/*
 * nextflow.config — cluster defaults + paths
 */

// Conda cache
conda.enabled = true
params.conda = "/projects/${USER}/software/anaconda/envs"

// Tool paths
params.NGS_CHECKMATE = "${params.conda}/ngscheckmate/NGSCheckMate"
params.HYSYS = "/projects/${USER}/software/HaveYouSwappedYourSamples"
params.BAMIXCHECKER = "/projects/${USER}/software/BAMixChecker_python3"

// Paths to data directories
params.projectDir = "${baseDir}"
params.bamsDir = "/pl/active/cgreene-sc-hgsoc/mismatch_project_data/aligned_reads"
params.pseudobulkDir = "/scratch/alpine/${USER}/hgsoc/simulations/scripts/pseudobulking/results/subset-bam"
params.vcfsDir = "/scratch/alpine/${USER}/hgsoc/simulations/scripts/experiment/results/1a_individual_vcf"
params.outdir = "intersection_results_maf_001_fixed"

// Dataset & experiment selection
params.dataset = "hgsoc" // options: high_grade_glioma, low_grade_glioma, hgsoc, central_nervous_system_tumor, wilms_tumor
params.pseudobulk = false  // options: true (pseudobulk samples), false (real data samples, e.g. bulk or single-cell)
params.ncells = 500000  // Number of cells included in pseudobulk samples
params.read_depth = [
    "high_grade_glioma": [
        "bulk": 3,
        "single-cell": 2,
        "default": 0
    ],
    "low_grade_glioma": [
        "bulk": 0,
        "single-cell": 2,
        "default": 0
    ],
    "hgsoc": [
        "bulk_dissociated_polyA": 3,
        "bulk_dissociated_ribo": 2,
        "bulk_chunk_ribo": 2,
        "single-cell": 25,
        "default": 0
    ],
    "hgsoc-new": [
        "bulk_chunk_ribo": 1,
        "bulk_dissociated_polyA": 1,
        "default": 0
    ],
    "wilms_tumor": [
        "bulk": 11,
        "single-nucleus": 32,
        "default": 0
    ],
    "default": [
        "default": 0
    ]
]



// ---
// Define profiles for different execution environments
// ---
profiles {

    // Profile for running locally on your machine (default if no profile is specified)
    local {
        process {
            executor = 'local' // Use the local executor
            cpus     = 2       // Adjust based on your local machine's cores
            memory   = '8 GB'  // Adjust based on your local machine's RAM
            time     = '4h'    // Adjust if local runs are typically shorter
        }

        params {
            refGenome="${params.projectDir}/refdata-gex-GRCh38-2024-A"
        }
    }

    // Profile for running on a SLURM HPC cluster
    slurm {
        process {
            executor = 'slurm'
            queue = 'amilan'
            clusterOptions = '--account=amc-general --qos=normal'
            
            // Default resources
            cpus = 4
            memory = '8 GB'
            time = '2h'

            withName: 'GENOTYPE_INDIVIDUAL' {
               maxForks = 20
               time = '1d'
            }

            withName: 'FILTER_BAM' {
               maxForks = 20
            }

            withName: 'VIREO_MATCH' {
                memory = '64 GB'
            }
            
            withName: 'BAMIXCHECKER' {
               memory = '64 GB'
               time = '1d'
            }
            
            withName: 'CROSSCHECK_FINGERPRINTS' {
                memory = '16 GB'
            }

            withName: 'HYSYS' {
                memory = '32 GB'
            }
        }

        params {
            refGenome="/projects/${USER}/hgsoc/refdata-gex-GRCh38-2024-A"
        }
        
        executor {
            queueSize = 50  // Max concurrent jobs
            submitRateLimit = '10 sec'  // Rate limiting
        }
    }
}
