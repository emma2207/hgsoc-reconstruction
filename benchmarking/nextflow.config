/*
 * nextflow.config — cluster defaults + paths
 */

// Conda cache
conda.enabled = true
params.conda = "/projects/${USER}/software/anaconda/envs"

// Tool paths
params.NGS_CHECKMATE = "${params.conda}/ngscheckmate/NGSCheckMate"
params.HYSYS = "/projects/${USER}/software/HaveYouSwappedYourSamples"
params.BAMIXCHECKER = "/projects/${USER}/software/BAMixChecker_python3"
params.TIMEATTACKGENCOMP = "/projects/${USER}/software/TimeAttackGenComp"
params.timeattackgencomp_target_bed = "${params.TIMEATTACKGENCOMP}/1000g_0.15MAF.refGene.uniq.hg38.sort.bed.gz"

// Paths to data directories
params.projectDir = "${baseDir}"
params.bamsDir = "/pl/active/cgreene-sc-hgsoc/mismatch_project_data/aligned_reads"
params.pseudobulkDir = "/pl/active/cgreene-sc-hgsoc/mismatch_project_data/pseudobulks"
params.vcfsDir = "/pl/active/cgreene-sc-hgsoc/mismatch_project_data/variant_calls_intersect_1000G"
params.outdir = "results/vcf_update"

// Dataset & experiment selection
params.dataset = "hgsoc" // options: high_grade_glioma, low_grade_glioma, hgsoc, central_nervous_system_tumor, wilms_tumor
params.pseudobulk = true  // options: true (pseudobulk samples), false (real data samples, e.g. bulk or single-cell)
params.ncells = 50000  // Number of cells included in pseudobulk samples
params.read_depth = [
    "high_grade_glioma": [
        "bulk": 3,
        "single-cell": 2,
        "upper": 65,
        "default": 0
    ],
    "low_grade_glioma": [
        "bulk": 0,
        "single-cell": 2,
        "upper": 38,
        "default": 0
    ],
    "hgsoc": [
        "bulk_dissociated_polyA": 0,
        "bulk_dissociated_ribo": 0,
        "bulk_chunk_ribo": 0,
        "single-cell": 0,
        "upper": 1500,
        "default": 0
    ],
    "hgsoc-new": [
        "bulk_chunk_ribo": 0,
        "bulk_dissociated_polyA": 0,
        "upper": 27,
        "default": 0
    ],
    "wilms_tumor": [
        "bulk": 11,
        "single-nucleus": 32,
        "upper": 650,
        "default": 0
    ],
    "default": [
        "upper": 1000,
        "default": 0
    ]
]



// ---
// Define profiles for different execution environments
// ---
profiles {

    // Profile for running locally on your machine (default if no profile is specified)
    local {
        process {
            executor = 'local' // Use the local executor
            cpus     = 2       // Adjust based on your local machine's cores
            memory   = '8 GB'  // Adjust based on your local machine's RAM
            time     = '4h'    // Adjust if local runs are typically shorter
        }

        params {
            refGenome="${params.projectDir}/refdata-gex-GRCh38-2024-A"
            snp_vcf="${params.projectDir}/genome1K.phase3.SNP_AF5e2.chr1toX.hg38.vcf.gz"
        }
    }

    // Profile for running on a SLURM HPC cluster
    slurm {
        process {
            executor = 'slurm'
            queue = 'acpu'
            clusterOptions = '--account=amc-general --qos=cpu-normal'
            
            // Default resources
            cpus = 4
            memory = '8 GB'
            time = '2h'

            withName: 'GENOTYPE_INDIVIDUAL' {
               maxForks = 20
               time = '1d'
            }

            withName: 'FILTER_BAM' {
               maxForks = 20
            }

            withName: 'VIREO_MATCH' {
                memory = '64 GB'
            }
            
            withName: 'BAMIXCHECKER' {
               memory = '64 GB'
               time = '1d'
            }
            
            withName: 'CROSSCHECK_FINGERPRINTS' {
                memory = '16 GB'
            }

            withName: 'HYSYS' {
                memory = '32 GB'
            }
            
            withName: 'PEDDY' {
                cache = false
            }

            withName: 'TIMEATTACKGENCOMP' {
                memory = '32 GB'
                time = '24h'
            }

            withName: 'CONPAIR' {
                memory = '32 GB'
                cpus = 4
            }

            withName: 'SOMALIER_EXTRACT' {
                memory = '16 GB'
                time = '1h'
            }

            withName: 'SOMALIER_RELATE' {
               memory = '16 GB'
               time = '8h'
            }
        }

        params {
            refGenome="/projects/${USER}/hgsoc/refdata-gex-GRCh38-2024-A"
            snp_vcf="/projects/${USER}/hgsoc/genome1K.phase3.SNP_AF5e2.chr1toX.hg38.vcf.gz"
        }
        
        executor {
            queueSize = 50  // Max concurrent jobs
            submitRateLimit = '10 sec'  // Rate limiting
        }
    }
}
